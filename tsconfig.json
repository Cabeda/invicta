{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strictNullChecks": true,
    "noImplicitAny": false,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": ["web/*.mjs"],
  "exclude": ["web/*.test.mjs"]
}
