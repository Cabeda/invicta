{
  "name": "invicta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "python3 prototypes/line-701/build_site.py",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test web/*.test.mjs prototypes/line-701/*.test.mjs scripts/*.test.mjs",
